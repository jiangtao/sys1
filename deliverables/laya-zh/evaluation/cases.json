{
  "version": "1.0",
  "description": "Laya 中文业务场景合成评测集；期望标签在运行模型前由人工定义。",
  "label_policy": "标签描述业务期望，不是模型输出；边界样本故意保留灰度，不能据此宣称生产精度。",
  "cases": [
    {
      "id": "agent-001",
      "suite": "agent",
      "state": {"task": "请先阅读仓库里的部署说明、最近日志和历史问题记录，整理当前故障的事实与复现条件。", "context": "现象尚未复现，没有明确修改方案。"},
      "expected": {"route": "research", "priority": 1, "needs_human": false}
    },
    {
      "id": "agent-002",
      "suite": "agent",
      "state": {"task": "按已经确认的方案，把 parser.py 的字段名从 old_id 改为 item_id，并补上对应单元测试。", "context": "文件范围、方案和验收标准都已写在任务单中。"},
      "expected": {"route": "implementation", "priority": 1, "needs_human": false}
    },
    {
      "id": "agent-003",
      "suite": "agent",
      "state": {"task": "支付接口偶发超时，请检查修复后的 API、数据库写入和消息队列消费，验证完整下单链路。", "context": "已有修复分支，目标是测试环境验收。"},
      "expected": {"route": "backend_test", "priority": 2, "needs_human": false}
    },
    {
      "id": "agent-004",
      "suite": "agent",
      "state": {"task": "验证用户从登录、搜索商品、加入购物车到提交订单的真实浏览器流程，并记录页面行为。", "context": "测试环境账号和验收步骤已经准备好。"},
      "expected": {"route": "e2e_test", "priority": 2, "needs_human": false}
    },
    {
      "id": "agent-005",
      "suite": "agent",
      "state": {"task": "为本地决策模型接入客服系统设计一套服务方案，比较同步 API、消息队列、缓存和失败回退的取舍。", "context": "需要在多个系统边界和部署方式之间做选择。"},
      "expected": {"route": "solution_design", "priority": 1, "needs_human": true}
    },
    {
      "id": "agent-006",
      "suite": "agent",
      "state": {"task": "请对照已确认的接口契约和验收清单，独立检查本次增量改动是否遗漏错误处理。", "context": "实现已经完成，基线文档和 diff 均可读取。"},
      "expected": {"route": "review", "priority": 1, "needs_human": false}
    },
    {
      "id": "agent-007",
      "suite": "agent",
      "state": {"task": "把线上客户资料导出后发送给外部合作方，顺便清理旧数据。", "context": "没有说明授权范围、收件人、保留要求，也没有确认删除边界。"},
      "expected": {"route": "main_agent", "priority": 2, "needs_human": true}
    },
    {
      "id": "agent-008",
      "suite": "agent",
      "state": {"task": "查找最近三次发布的错误日志、相关 issue 和回滚记录，判断缓存命中率下降从何时开始。", "context": "目前需要事实调查，尚未进入修改阶段。"},
      "expected": {"route": "research", "priority": 1, "needs_human": false}
